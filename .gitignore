local.properties

# 固定簽名檔：必須提交，否則 CI 每次簽名唔同、無法覆蓋安裝
!keystore/hketa.jks
!keystore/hketa.jks.b64
!app/debug.keystore

# 預編譯 Rust 內核：必須提交。
# 有咗呢啲 .so，CI 會偵測到「已有預編譯」而直接跳過現場 cargo 編譯 ——
# 咁就 100% 保證每個 APK 都包咗 Rust 內核，唔會行返純 Kotlin 回退。
# 本地重新產生：./rust/build-android.sh
!app/src/main/jniLibs/
!app/src/main/jniLibs/**/*.so
