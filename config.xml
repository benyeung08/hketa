<?xml version='1.0' encoding='utf-8'?>
<widget id="com.hketa.app" version="1.0.0" android-versionCode="1"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>HKETA</name>
  <description>Hong Kong public transport ETA — KMB / Citybus / NLB / GMB / MTR / Light Rail</description>
  <author email="you@example.com" href="https://github.com/yourname/hketa-apk">Your Name</author>

  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="geo:*" />
  <allow-intent href="market:*" />
  <allow-intent href="https://github.com/*" />
  <allow-intent href="https://objects.githubusercontent.com/*" />
  <allow-navigation href="https://data.etabus.gov.hk/*" />
  <allow-navigation href="https://rt.data.gov.hk/*" />
  <allow-navigation href="https://data.etagmb.gov.hk/*" />
  <allow-navigation href="https://opendata.mtr.com.hk/*" />
  <allow-navigation href="https://api.github.com/*" />
  <allow-navigation href="https://github.com/*" />

  <!-- Kotlin Cordova plugin support (cordova-android 15 default Kotlin 2.1.21). -->
  <preference name="GradlePluginKotlinEnabled" value="true" />
  <preference name="GradlePluginKotlinVersion" value="2.1.21" />

  <!-- Installable & runnable on Android 8.0 (API 26) ... Android 17 (API 37) devices.
       minSdk 26 blocks Android 7.x and older. targetSdk/compileSdk 36 is the
       highest level officially validated by cordova-android 15; Android 17 is
       backward compatible, so the same APK installs and runs fine there.

       maxSdkVersion is deliberately NOT set: Google discourages it (an OS
       upgrade could remove the app). The Settings screen shows a "beyond
       verified range" notice on API 38+ instead of blocking anything.

       Do NOT bump target/compile to 37 yet: AGP 8.13 tops out at API 36.1 and
       cordova-android 15's check_android_target rejects the "android-37.0"
       package name. See README → "Why not target API 37 yet" for the path. -->
  <preference name="android-minSdkVersion" value="26" />
  <preference name="android-targetSdkVersion" value="36" />
  <preference name="android-compileSdkVersion" value="36" />

  <preference name="AndroidXEnabled" value="true" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="Fullscreen" value="false" />

  <!-- Launcher icon generated from res/android/logo-source.png.
       cordova-android 15 turns background/foreground into mipmap-*-v26
       adaptive icons and monochrome into Android 13+ themed icons;
       src is the legacy fallback. minSdk 26 => every supported device
       gets the adaptive version. -->
  <platform name="android">
    <icon density="mdpi"    src="res/android/icons/mdpi/ic_launcher.png"
          background="res/android/icons/mdpi/ic_launcher_background.png"
          foreground="res/android/icons/mdpi/ic_launcher_foreground.png"
          monochrome="res/android/icons/mdpi/ic_launcher_monochrome.png" />
    <icon density="hdpi"    src="res/android/icons/hdpi/ic_launcher.png"
          background="res/android/icons/hdpi/ic_launcher_background.png"
          foreground="res/android/icons/hdpi/ic_launcher_foreground.png"
          monochrome="res/android/icons/hdpi/ic_launcher_monochrome.png" />
    <icon density="xhdpi"   src="res/android/icons/xhdpi/ic_launcher.png"
          background="res/android/icons/xhdpi/ic_launcher_background.png"
          foreground="res/android/icons/xhdpi/ic_launcher_foreground.png"
          monochrome="res/android/icons/xhdpi/ic_launcher_monochrome.png" />
    <icon density="xxhdpi"  src="res/android/icons/xxhdpi/ic_launcher.png"
          background="res/android/icons/xxhdpi/ic_launcher_background.png"
          foreground="res/android/icons/xxhdpi/ic_launcher_foreground.png"
          monochrome="res/android/icons/xxhdpi/ic_launcher_monochrome.png" />
    <icon density="xxxhdpi" src="res/android/icons/xxxhdpi/ic_launcher.png"
          background="res/android/icons/xxxhdpi/ic_launcher_background.png"
          foreground="res/android/icons/xxxhdpi/ic_launcher_foreground.png"
          monochrome="res/android/icons/xxxhdpi/ic_launcher_monochrome.png" />
  </platform>

  <engine name="android" spec="^15.1.0" />
  <!-- The local Kotlin plugin is installed explicitly via
       `cordova plugin add ./native-plugin/hketa-native` (see package.json / workflow). -->
  <hook type="before_build" src="scripts/verify-kotlin.js" />
</widget>
