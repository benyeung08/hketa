<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="hketa-native"
        version="1.0.0">
  <name>HkEtaNative</name>
  <description>Kotlin native bridge for HKETA: device/app info, geo map intent, toast, keep-awake and GitHub Release in-app APK update.</description>
  <license>MIT</license>
  <keywords>cordova,android,kotlin,hketa,eta,in-app-update</keywords>

  <js-module src="www/hketaNative.js" name="HkEtaNative">
    <clobbers target="window.HkEtaNative" />
  </js-module>

  <platform name="android">
    <config-file parent="/*" target="res/xml/config.xml">
      <feature name="HkEtaNative">
        <param name="android-package" value="com.hketa.nativebridge.HkEtaNative" />
      </feature>
    </config-file>

    <config-file parent="/manifest" target="AndroidManifest.xml">
      <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
      <!-- Android 8+ requires this to launch an APK install intent from a sideloaded app. -->
      <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

      <!-- Android 11 (API 30+) package visibility: resolveActivity() returns null
           for external apps unless the intent signatures are declared here.
           Without these, the map button, the APK installer and the browser
           fallback silently fail on modern devices. -->
      <queries>
        <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="geo" />
        </intent>
        <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:scheme="https" />
        </intent>
        <intent>
          <action android:name="android.intent.action.VIEW" />
          <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
      </queries>
    </config-file>

    <!-- cordova-android 15 maps app/... target-dir verbatim.
         Do NOT use the deprecated src/... prefix for .kt files. -->
    <source-file src="src/android/HkEtaNative.kt"
                 target-dir="app/src/main/java/com/hketa/nativebridge" />
  </platform>
</plugin>
