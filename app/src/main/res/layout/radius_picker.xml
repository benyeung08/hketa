<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference screenshot: a dark rounded bar with a big white number ("50"),
  a small unit and a grey ▼ on the right. Tapping the whole bar opens a
  single-choice dialog (see SettingsActivity.setupRadiusSection()).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radiusPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/radiusPickerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="500"
        android:textColor="@color/pill_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/radiusPickerUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/nearby_radius_unit"
        android:textColor="@color/pill_muted"
        android:textSize="18sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/radiusPickerArrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/nearby_radius_cd"
        android:src="@drawable/ic_pill_arrow_down" />

</LinearLayout>
