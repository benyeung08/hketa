<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference layout:  [ v2.8.4 · 83        ⟳  🕐  ⧉ ]
  - tvAppVersion : installed versionName, always with a "v" prefix
  - tvAppBuild   : installed versionCode (build number)
  - pillRefresh  : re-run the GitHub Release check
  - pillHistory  : show last-check / cached-result dialog
  - pillCopy     : copy "vX · build · owner/repo" to the clipboard
  All three actions are shortcuts; the full download / install / signature
  controls remain in the 進階設定 drawer below this pill.
  The two texts below are DESIGN-TIME PREVIEWS only: SettingsActivity.kt
  overwrites them at runtime from PackageInfo (versionName / versionCode),
  so they must simply match the current bumped version for a sane preview.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updatePill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_pill"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.1"
        android:textColor="@color/pill_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPillDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:text="·"
        android:textColor="@color/pill_muted"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvAppBuild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        android:textColor="@color/pill_text"
        android:textSize="20sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/pillRefresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pill_refresh_cd"
        android:focusable="true"
        android:src="@drawable/ic_pill_refresh" />

    <ImageView
        android:id="@+id/pillHistory"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pill_history_cd"
        android:focusable="true"
        android:src="@drawable/ic_pill_history" />

    <ImageView
        android:id="@+id/pillCopy"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/pill_copy_cd"
        android:focusable="true"
        android:src="@drawable/ic_pill_copy" />

</LinearLayout>
