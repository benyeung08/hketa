<?xml version="1.0" encoding="utf-8"?>
<!--
  ROUTE_DETAIL_NO_MAP
  Tapping a nearby-route card on the Home page opens THIS full screen.

  It reproduces the reference screenshot's red header and the lower
  "stop sequence + next three arrivals" list, but deliberately contains
  NO MAP: the Google-Maps area is replaced by a lightweight paper strip
  with a red route line and the current-stop bubble. No map SDK / tiles /
  network map request / Google attribution is used.

  Honest placeholders: fare and predicted alighting time are NOT in the
  public ETA APIs, so they render as "—" with an explicit footer note
  instead of invented numbers like "$5.6" or "15:31".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ===== 紅色頂欄：← +「12 往 尖沙咀東（麼地道）(YT927)」+ 三個圓形動作 ===== -->
    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="12 往 尖沙咀東 (YT927)"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailActionTrips"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_trips_cd"
            android:focusable="true"
            android:gravity="center"
            android:text="▦"
            android:textColor="@color/brand"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detailActionFav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_fav_cd"
            android:focusable="true"
            android:gravity="center"
            android:text="★"
            android:textColor="@color/brand"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/detailActionDirection"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_direction_cd"
            android:focusable="true"
            android:gravity="center"
            android:text="⇄"
            android:textColor="@color/brand"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- ===== NO_MAP_PANEL：用一條紅色路線 + 站名氣泡取代 Google 地圖 ===== -->
    <LinearLayout
        android:id="@+id/noMapPanel"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_no_map"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_no_map_label"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="26dp"
                android:layout_height="4dp"
                android:background="@color/brand" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="@color/brand" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_detail_dot_on" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStopBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_stop_bubble"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="海麗邨巴士總站 (SS667)"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 主體：左側四個 chip + 右側站序時間軸 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/detailSideChips"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/chipBoard"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_board"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipNearby"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_nearby"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFav"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_fav"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipMore"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_more"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailStopsRecycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDetailFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/detail_footer_honest"
        android:textColor="@color/muted"
        android:textSize="10sp" />

</LinearLayout>
