<?xml version="1.0" encoding="utf-8"?>
<!--
  ROUTE_DETAIL_NO_MAP
  Tapping a nearby-route card on the Home page opens THIS full screen.

  It reproduces the reference screenshot's red header and the lower
  "stop sequence + next three arrivals" list, but deliberately contains
  NO MAP: the Google-Maps area is replaced by a lightweight paper strip
  with a red route line and the current-stop bubble. No map SDK / tiles /
  network map request / Google attribution is used.

  Honest placeholders: fare and predicted alighting time are NOT in the
  public ETA APIs, so they render as "—" with an explicit footer note
  instead of invented numbers like "$5.6" or "15:31".

  DETAIL_STOP_BLACK / DETAIL_ALL_BLACK: the whole screen has a fixed WHITE
  background, so stop names AND every auxiliary label (fare / alight / minutes
  / clock / map label / footer) use PURE BLACK colours (detail_stop_text /
  detail_aux_text) that do NOT flip to near-white in values-night. The footer
  background is pinned pale for the same reason. The red header and the four
  dark chips keep their white-on-red / white-on-dark text; the big minute
  numbers keep their blue detail_minutes colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ===== 紅色頂欄：← +「12 往 尖沙咀東（麼地道）(YT927)」+ 圓形動作 =====
         DETAIL_THREE_ICONS: 所有單向（非循環）路線**只有呢三個圖標** ——
           ① 日曆  = 服務時間及班次（detailActionCalendar）
           ② 通知  = 官方 ETA 備註／服務通告（detailActionNotice）
           ③ 切換方向 = ⇅（detailActionDirection）
         CIRCULAR_TWO_ACTIONS: 所有循環線**只有呢兩個圖標** ——
           ① 日曆 = 服務時間及班次（同單向路線同一個 dialog，唔縮水）
           ② 通知 = 服務通告
         LOCAL_SERVICE_HOURS: 日曆 dialog 只讀本機路線資料，唔行即時 ETA。
         循環線冇回程方向，由 CircularRoutes.visibleHeaderActions(boolean)
         把第三顆 ⇅ 設 GONE，頭兩顆顯式 VISIBLE，對應第二張參考圖。
         三顆都係白圓 bg_detail_action_circle + 紅色 vector，唔加／唔減 View。 -->
    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="12 往 尖沙咀東 (YT927)"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ① 日曆＝服務時間及班次 -->
        <ImageView
            android:id="@+id/detailActionCalendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_calendar_cd"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_detail_calendar" />

        <!-- ② 通知＝服務通告（官方 ETA remark_tc） -->
        <ImageView
            android:id="@+id/detailActionNotice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_notice_cd"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_detail_notice" />

        <!-- ③ 切換方向＝⇅（循環線 GONE） -->
        <ImageView
            android:id="@+id/detailActionDirection"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_action_circle"
            android:clickable="true"
            android:contentDescription="@string/detail_action_direction_cd"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_detail_direction" />
    </LinearLayout>

    <!-- ===== NO_MAP_PANEL：用一條紅色路線 + 站名氣泡取代 Google 地圖 ===== -->
    <LinearLayout
        android:id="@+id/noMapPanel"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_no_map"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- JOINT_KMB_CTB: for a 城巴/九巴 route the Activity appends
             " · 城巴/九巴" to this label, so the route-level operator is
             visible even on the full-screen detail page. -->
        <TextView
            android:id="@+id/tvNoMapLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_no_map_label"
            android:textColor="@color/detail_aux_text"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="26dp"
                android:layout_height="4dp"
                android:background="@color/brand" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="@color/brand" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_detail_dot_on" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStopBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_stop_bubble"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="海麗邨巴士總站 (SS667)"
            android:textColor="@color/detail_stop_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 主體：左側四個 chip + 右側站序時間軸 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/detailSideChips"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/chipBoard"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_board"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipNearby"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_nearby"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFav"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_fav"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipMore"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_detail_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/detail_chip_more"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailStopsRecycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- DETAIL_ALL_BLACK: the footer used @color/surface, which turns #0F1622
         (near-black) in values-night. With the text now PURE BLACK that would
         be black-on-black, so the footer background is pinned to the same
         pale #F4F7FB as the day theme. The whole screen is now consistent
         light-background / black-text in every system appearance. -->
    <TextView
        android:id="@+id/tvDetailFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F7FB"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/detail_footer_honest"
        android:textColor="@color/detail_aux_text"
        android:textSize="10sp" />

</LinearLayout>
