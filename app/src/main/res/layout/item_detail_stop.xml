<?xml version="1.0" encoding="utf-8"?>
<!--
  One stop in the APP1933 route-detail timeline:
    ●  1. 海麗邨巴士總站 (SS667)
    │     車資 —
    │        4  分鐘 15:30 預定班次
    │       29  分鐘 15:55 預定班次
    │       54  分鐘 16:20 預定班次
  Only the selected (上車) stop expands the three arrivals.

  DETAIL_STOP_BLACK / DETAIL_ALL_BLACK: this row sits on a fixed WHITE
  background. ALL text — stop names, fare, alight, minutes unit, clock and
  tags — is now PURE BLACK (detail_stop_text / detail_aux_text are both
  #000000). Neither colour flips to a near-white value in values-night, so
  the whole list stays readable in dark mode too. Do NOT switch these back
  to the generic theme text / muted colours. Blue detail_minutes numbers are
  an intentional accent and stay blue.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailStopRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <!-- 時間軸：上車紅點 / 其後灰圈 + 紅色直線 -->
    <LinearLayout
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_alight"
            android:textColor="@color/detail_aux_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvAlightTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/detail_na"
            android:textColor="@color/detail_aux_text"
            android:textSize="10sp" />

        <View
            android:id="@+id/detailDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_detail_dot_off" />

        <View
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/brand" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvStopTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 海麗邨巴士總站 (SS667)"
            android:textColor="@color/detail_stop_text"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvFare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/detail_fare_na"
            android:textColor="@color/detail_aux_text"
            android:textSize="12sp" />

        <!-- SECOND_STOP_PREDICTIONS：第二站起嘅兩層「預計到站時間」。
             第一層「×× 分鐘」、第二層「××:××」，數字係官方即時 ETA，
             唔係推算；冇回報就顯示 detail_predict_na「—」。 -->
        <LinearLayout
            android:id="@+id/predictContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPredictLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_predict_label"
                android:textColor="@color/detail_aux_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPredictMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/detail_minutes"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPredictClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/detail_aux_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPredictNa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_predict_na"
                android:textColor="@color/detail_aux_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 三班次：只喺上車站展開 -->
        <LinearLayout
            android:id="@+id/tripContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tripRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tripMin1"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/detail_minutes"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minutes"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripClock1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripTag1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tripRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tripMin2"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/detail_minutes"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minutes"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripClock2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripTag2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tripRow3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tripMin3"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/detail_minutes"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minutes"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripClock3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tripTag3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/detail_aux_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoEta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/detail_no_eta"
                android:textColor="@color/detail_aux_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
