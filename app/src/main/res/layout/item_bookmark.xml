<?xml version="1.0" encoding="utf-8"?>
<!-- SEARCH_UI_2026-11-23：「我的書籤」列，重用同一深色紀錄列視覺 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookmarkRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/search_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/bookmarkStar"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="@color/search_green"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bookmarkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/search_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/bookmarkMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/search_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/search_muted"
        android:textSize="24sp" />
</LinearLayout>
