<?xml version="1.0" encoding="utf-8"?>
<!--
  SEARCH_UI_2026-11-23 — 對照截圖嘅「搜尋紀錄」列：
      [綠色時鐘] [KMB]  九巴 272P                              ✕
                        富蝶總站 至 葵興站
                        只在特定日期及/或時間提供服務。
  ⚠️ 官方目錄只有目的地（dest），冇起點，所以副標題如實顯示「往 XXX」，
     唔會捏造「A 至 B」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/search_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/resultClock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/search_clear"
                android:src="@drawable/ic_clock"
                android:visibility="gone" />

            <TextView
                android:id="@+id/resultBadge"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_badge"
                android:gravity="center"
                android:text="KMB"
                android:textColor="@color/search_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="九巴 272P"
                android:textColor="@color/search_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/resultDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="往 葵興站"
                android:textColor="@color/search_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/resultNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/search_hint"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/resultRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="@string/search_clear"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@color/search_divider" />

</LinearLayout>
