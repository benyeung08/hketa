<?xml version="1.0" encoding="utf-8"?>
<!--
  APP1933-style shell.
  The Java data layer (8 operators), SettingsActivity, catalogue updater,
  in-app updater and signature verification are ALL kept. Only the shell,
  the home cards and the arrival formatting change here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipChildren="false">

    <!--
      NAV_OVERLAY_POSITION: 內容填滿成個螢幕，液態玻璃導航欄係另一個
      overlay 子View（見檔案最底）。咁樣 App 內容會同時出現喺膠囊
      「後面」同「下面」，同參考截圖一致（藍色「安裝」掣被半透明遮住、
      膠囊下面仍見到下一列 App）。各捲動頁加咗 bottom padding，
      最后一筆資料仍然捲得到。
    -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- KMB-red header, like the official app -->
    <LinearLayout
        android:id="@+id/mainHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/header_subtitle"
                android:textColor="#FFE3E3"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="APP1933 格式"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:text="@string/welcome"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <!-- AUTO_REFRESH_ETA_STATUS：前景輪詢開關／間隔／上次自動更新時間 -->
    <TextView
        android:id="@+id/tvAutoRefreshStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/muted"
        android:textSize="10sp" />

    <!-- 4 tab pages; visibility is switched by MainActivity -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================ 主頁 ============================ -->
        <LinearLayout
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- HOME_CLEAN: 冇「↻ 刷新」掣、冇半徑 Spinner；距離改喺設定頁，
                 主頁淨係用下面嘅 SwipeRefreshLayout 下拉刷新。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_title"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_swipe_hint"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 手動定位掣已移除：授權後由 MainActivity 自動定位。
                 未授權時呢列係「授予權限」提示，唔係定位掣。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/trips_hint"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/permissionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="@string/location_permission_hint"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHomeEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:text="@string/home_empty"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="180dp" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!--
              NAV_NO_FAV_BUTTON: 取消「☆ 加入收藏」長條掣 —— 佢原本喺主頁
              附近路線列表底、懸浮液態玻璃導航欄 overlay 下面（見用家截圖）。
              收藏功能冇取消：路線詳情頁「收藏」動作、設定頁「★ 我的收藏」
              入口、收藏頁同長按移除照舊，只係唔再喺導航欄下顯示呢個掣，
              亦唔留任何隱藏 View（NAV_NO_FAV_TAB 連導航欄嗰粒 tab 都取消）。
            -->
        </LinearLayout>

        <!-- ============================ 收藏 ============================ -->
        <LinearLayout
            android:id="@+id/pageFav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/fav_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFavEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/fav_empty"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="180dp" />
        </LinearLayout>

        <!-- ============ 搜尋（SEARCH_UI_2026-11-23：對照截圖嘅深色分類式版面） ============
             固定深色底＋綠色重點；頂部 8 個交通類別 tab、第二排營運商 chips、
             綠框「路線號碼」、搜尋紀錄（我的書籤已取消）。
             底層 8 種查詢模式、官方目錄預載、點列開詳情頁（帶方向）、
             站序／方向／篩選全部保留，一個都無郁。 -->
        <LinearLayout
            android:id="@+id/pageSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/search_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 頂部分類 tab：可橫向捲動；選中綠字＋綠色底線 -->
            <HorizontalScrollView
                android:id="@+id/searchCatScroll"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/searchCatRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catMtr"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_mtr"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catMtrUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catBus"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_bus" android:textStyle="bold"
                    android:textColor="@color/search_green"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catBusUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="visible" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catGmb"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_gmb"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catGmbUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catFerry"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_ferry"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catFerryUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catTram"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_tram"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catTramUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catTaxi"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_taxi"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catTaxiUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catNplb"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_nplb"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catNplbUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/catResident"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/search_cat_resident"
                    android:textColor="@color/search_text"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/catResidentUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_search_cat_underline"
                    android:visibility="gone" />
            </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/search_divider" />

            <!-- 營運商 chips：只喺「巴士」類別顯示，可橫向捲動 -->
            <HorizontalScrollView
                android:id="@+id/searchChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/searchChipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_all"
                android:textColor="@color/search_green_text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/chipCtb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_ctb"
                android:textColor="@color/search_text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/chipKmb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_kmb"
                android:textColor="@color/search_text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/chipLwb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_lwb"
                android:textColor="@color/search_text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/chipNlb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_nlb"
                android:textColor="@color/search_text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/chipDb"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_chip_db"
                android:textColor="@color/search_text"
                android:textSize="16sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 非巴士類別：如實提示，唔捏造冇 API 嘅班次 -->
            <TextView
                android:id="@+id/tvCategoryNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/search_no_api"
                android:textColor="@color/search_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 綠色描邊「路線號碼」輸入框（用系統 IME，取代舊自訂鍵盤） -->
            <EditText
                android:id="@+id/routeInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:hint="@string/search_route_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/search_text"
                android:textColorHint="@color/search_hint"
                android:textSize="19sp" />

            <!--
              SEARCH_LOCAL_DATA: 恢復本地資料喺搜尋功能上 —— 顯示本機線路資料
              狀態（來源／筆數／有冇快照），並如實標示預載列係「本機資料」
              定「即時 API」。撳一下去「應用程式設置 → 線路資料更新」。
              顏色全部用既有 search 色盤，冇新增任何色值。
            -->
            <TextView
                android:id="@+id/tvLocalDataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/search_field_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/search_local_never"
                android:textColor="@color/search_green"
                android:textSize="13sp" />

            <!-- 即時結果：輸入非空時顯示（精確／前綴符合，最多 4 條） -->
            <LinearLayout
                android:id="@+id/searchResultsView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/searchEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="@string/search_empty"
                    android:textColor="@color/search_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/searchResultsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="180dp" />
            </LinearLayout>

            <!-- SEARCH_NO_BOOKMARK: 輸入為空只剩搜尋紀錄；「我的書籤」區塊已取消 -->
            <LinearLayout
                android:id="@+id/searchHomeView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="visible">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="@string/search_history_title"
                    android:textColor="@color/search_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/search_divider" />

                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="18dp"
                    android:text="@string/search_history_empty"
                    android:textColor="@color/search_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.74">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/historyRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="180dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPreloadHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="@string/search_preload_hint"
                    android:textColor="@color/search_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              SEARCH_NO_ADVANCED: 「進階：站序／方向／篩選 ›」掣已取消。
              底部懸浮液態玻璃導航欄由原本只喺進階模式出現，改為常駐喺
              主搜尋頁（見 MainActivity.hideChrome / showSearchHome）。
              以下 8 模式／站序區塊永久隱藏：保留 View 只為既有資料層
              綁定相容（routeEdit / companySpinner / stopsRecycler 等），
              用戶冇任何入口切去，亦唔會再顯示。
            -->
            <LinearLayout
                android:id="@+id/stopSequenceView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/routeEdit"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:hint="@string/hint_route"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/muted"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/companySpinner"
                            android:layout_width="118dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:spinnerMode="dialog" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoadStops"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/load_stops"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/stopEdit"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/hint_stop"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuery"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/query_eta"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDirection"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/direction_switch"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etFilter"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/filter_stop_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stopsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/stops_header"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stopsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ====== 應用程式設置（原「更多」；長免責聲明已搬入 SettingsActivity） ====== -->
        <LinearLayout
            android:id="@+id/pageMore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="200dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/more_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/settings"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:text="@string/more_settings_hint"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavList"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:text="@string/fav_list"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="@string/more_disclaimer_moved"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

    </FrameLayout>

    </LinearLayout>
    <!-- /mainContent：以下係真正浮喺內容上面嘅導航欄 overlay -->

    <!--
      NAV_GEOMETRY / NAV_OVERLAY_POSITION: 對照截圖嘅深灰黑「藥丸」導航欄 ——
      高 56dp、水平置中、左右收窄（NavGlass.geometry() 按屏寬動態調整）、
      NAV_NO_FAV_TAB: 導航欄只係「主頁／搜尋／應用程式設置」三分頁，
      「★ 收藏」tab 已取消（收藏頁改由設定頁「★ 我的收藏」掣進入）。
      全圓角 (radius = 28dp = 高度一半)。
      ★ 位置改咗：唔再係貼底 8dp 嘅「佔位列」，而係 FrameLayout 嘅
        overlay（layout_gravity=bottom|center_horizontal），並由
        NavGlass.geometry() 按螢幕高度上移到離底約 12%（48–160dp）。
        所以膠囊後面同下面都見到內容，同截圖一致。
      選中 tab 係內嵌深色 pill + 藍色字，未選中係淺灰字。
      外觀（深色／高對比／減少動態）仍由 NavGlass 跟隨系統設定改變。
    -->
    <LinearLayout
        android:id="@+id/bottomTabs"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_nav_glass"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/tab_home"
            android:textColor="@color/nav_tab_active"
            android:textSize="10sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tabSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/tab_search"
            android:textColor="@color/nav_tab_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/tab_more"
            android:textColor="@color/nav_tab_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!--
      NAV_LIQUID: 疊喺玻璃藥丸上面嘅「液態」層 —— 同 bottomTabs 用完全
      相同嘅幾何（NavGlass.geometry() 會一併重算），但 clickable=false，
      觸控照舊穿透落四個分頁。
        · navLiquidRim   ：由上淡出嘅折射亮邊 + 1dp 內描邊
        · navLiquidSheen：168dp 白色漸變高光，由 NavGlass 用
                          ValueAnimator 左右來回流動（API 31+ 加 RenderEffect）
      兩層嘅 alpha / 動畫 / RenderEffect 全部由 NavLiquid 純決策層按
      「跟隨系統外觀／高對比／減少動態」控制；關閉時 alpha=0、完全靜態。
      layer 由 Kotlin setClipToOutline(true) 裁成同一個 28dp 圓角，
      高光唔會漏出藥丸邊。
    -->
    <FrameLayout
        android:id="@+id/navLiquidLayer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="96dp"
        android:clickable="false"
        android:clipChildren="true"
        android:elevation="6.2dp"
        android:focusable="false">

        <View
            android:id="@+id/navLiquidRim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"
            android:clickable="false"
            android:focusable="false" />

        <View
            android:id="@+id/navLiquidSheen"
            android:layout_width="168dp"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:alpha="0.55"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

</FrameLayout>
