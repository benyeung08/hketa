<?xml version="1.0" encoding="utf-8"?>
<!--
  NAV_GEOMETRY / DEFAULT appearance: the dark charcoal capsule from the
  reference screenshot (not the old blue-tinted wide bar).
  radius 28dp = half of the 56dp bar height -> a true pill shape.
  NavGlass.kt swaps to the dark / high-contrast variants according to
  system settings; all three share the same 28dp geometry.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#F02C2C2F"
        android:endColor="#F01D1D20"
        android:startColor="#F23B3B3E"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp" />
</shape>
