<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating "liquid glass" bottom bar: translucent tinted gradient, a thin
  white rim and a soft top highlight. Used as the DEFAULT appearance.
  NavGlass.kt swaps to the dark / high-contrast / reduced-motion variants
  according to system settings (night mode, high contrast, animator scale).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#B32A3340"
        android:endColor="#D4161F2A"
        android:startColor="#CC465666"
        android:type="linear" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp" />
</shape>
