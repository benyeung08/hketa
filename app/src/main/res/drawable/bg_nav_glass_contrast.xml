<?xml version="1.0" encoding="utf-8"?>
<!--
  NAV_GEOMETRY / ACCESSIBILITY: opaque solid pill with a strong white rim.
  Same 28dp radius / 56dp height geometry as the other two variants.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF101820" />
    <corners android:radius="28dp" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp" />
</shape>
