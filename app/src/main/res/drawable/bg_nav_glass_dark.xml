<?xml version="1.0" encoding="utf-8"?>
<!-- NAV_GEOMETRY / NIGHT: even deeper charcoal pill, same 28dp radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#F51E1E21"
        android:endColor="#FA101012"
        android:startColor="#F02B2B2F"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp" />
</shape>
