<?xml version="1.0" encoding="utf-8"?>
<!-- Night-mode variant: deeper glass, brighter rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#DD0C1420"
        android:endColor="#EE070B12"
        android:startColor="#CC1C2A3A"
        android:type="linear" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="#A6FFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp" />
</shape>
