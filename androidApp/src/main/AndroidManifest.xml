<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 15+ 前台服務類型權限（資料同步） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知權限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        minSdkVersion="24" → supports Android 7.0 (Nougat) and above.
        targetSdkVersion="37" → Android 17 (latest stable)
        The networkSecurityConfig below is required on Android 9+ (API 28+)
        to allow cleartext HTTP traffic to the local TypeScript API server.
    -->
    <application
        android:name=".HkEtaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HkEta">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RouteDetailActivity"
            android:exported="false"
            android:label="@string/label_stops" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- 資料更新前台服務 (Android 14+ 需要指定 foregroundServiceType) -->
        <service
            android:name=".data.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
