<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext (HTTP) traffic for development / local API server.
        On Android 9 (API 28) and above, cleartext is blocked by default.
        In production, replace with HTTPS endpoints and remove this config.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
