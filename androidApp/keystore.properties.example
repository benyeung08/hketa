# ============================================================
#  HK ETA — Keystore 配置範例
#  複製此檔案為 keystore.properties 並填入你的簽名資訊
#  注意：keystore.properties 已在 .gitignore 中，不會被提交
# ============================================================

# 簽名金鑰路徑（相對於 androidApp/ 目錄）
storeFile=../hketa-release-key.jks

# Keystore 密碼
storePassword=your_store_password

# 金鑰別名
keyAlias=hketa

# 金鑰密碼
keyPassword=your_key_password
