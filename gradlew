#!/usr/bin/env sh
# Gradle wrapper launcher for hketa.
# The wrapper JAR is generated by Android Studio, or by:
#   gradle wrapper --gradle-version 8.7
set -e

APP_HOME=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
    echo "找不到 gradle-wrapper.jar" >&2
    echo "請先執行： gradle wrapper --gradle-version 8.7" >&2
    echo "或直接用 Android Studio 開啟本專案（IDE 會自動補齊）。" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
